# name: test/sql/decode_tiny_buffer.test
# description: Buffers smaller than a 4-byte lookup must not overflow the encoded buffer and still decode every character
# group: [sql]

require encodings

# A one byte buffer rejects every line but still has to decode the whole file
query I
SELECT string_agg(v, '') FROM read_csv('data/boundaries/tiny_gb18030.csv', encoding='gb18030', buffer_size=1, header=true, columns={'v': 'VARCHAR'}, auto_detect=false, ignore_errors=true)
----
NULL

foreach buffer_size 3 4 5

query I
SELECT string_agg(v, '') FROM read_csv('data/boundaries/tiny_gb18030.csv', encoding='gb18030', buffer_size={buffer_size}, header=true, columns={'v': 'VARCHAR'}, auto_detect=false)
----
ĀĀĀĀĀ

endloop
